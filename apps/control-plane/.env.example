# 控制面环境变量（复制为 .env 或部署注入；生产密钥经 D20 密钥服务注入）

# 服务
CP_PORT=4000

# 认证（dev 仅本地开发；生产必须 oidc）
CP_AUTH_MODE=dev
CP_JWT_SECRET=dev-secret-change-me
CP_JWT_TTL=2h

# 钉钉 OIDC（CP_AUTH_MODE=oidc 时必填；用钉钉 OIDC 兼容端点）
# CP_OIDC_ISSUER=https://api.dingtalk.com/...
# CP_OIDC_CLIENT_ID=
# CP_OIDC_CLIENT_SECRET=
# CP_OIDC_REDIRECT_URI=http://127.0.0.1:4000/api/auth/sso/callback
# CP_OIDC_SCOPE=openid profile

# 角色映射（D12 部门标签驱动）：IT部:admin,研发部:developer
CP_ROLE_MAP_BY_DEPT=IT部:admin,研发部:developer

# 实例编排：memory（开发/冒烟）| docker（生产，podman/docker CLI）
CP_ORCHESTRATOR=memory
CP_CONTAINER_CMD=podman
CP_DSH_WEB_IMAGE=company-dsh-web:latest
CP_MAX_INSTANCES=30
CP_IDLE_REAP_MS=1800000

# 审计落库（PG；未配置则内存回退）
# DATABASE_URL=postgres://adaptix:adaptix_password@127.0.0.1:5432/control_plane

# D20 密钥服务：AES-GCM 主密钥（生产必填；本地可回退 CP_JWT_SECRET）
# SECRETS_MASTER_KEY=

# DeepSeek 官方（bootstrap 进 vault，引用名 DEEPSEEK_API_KEY）
# DS_API_KEY=
# DS_API_MODEL=deepseek-v4-flash

# 知识库 embedding（bootstrap 进 vault，引用名 EMBED_API_KEY）
# EMBED_API_KEY=
